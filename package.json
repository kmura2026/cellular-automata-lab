{
  "name": "cellular-automata-lab",
  "version": "0.1.0",
  "description": "Experiments with cellular automata.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc",
    "lint": "biome check .",
    "format": "biome format --write .",
    "start": "npm run build && node dist/src/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.155.0"
  }
}
